// Four chiplet positions: 0=(0,0), 1=(1,0), 2=(0,1), 3=(1,1).
// The 4-cycle edge weight is a placeholder for the complete E/O, optical,
// propagation, and O/E path. Power and area are estimated separately.
graph photonic_mesh_2_2 {
    node [pipeline_stage_delay=1]
    edge [weight=4]
    0--1;
    0--2;
    1--3;
    2--3;
}
